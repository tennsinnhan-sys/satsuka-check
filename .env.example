# Notion Integration Token
# https://www.notion.so/my-integrations で作成した「シークレット」を貼り付け
NOTION_TOKEN=secret_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 対象のNotionデータベースID(ダッシュ付き32文字)
# 「アイドル撮影レギュレーション」DBのID(デフォルトで設定済み)
NOTION_DATABASE_ID=3923b6a2-08e9-80bd-82f5-cc6396b4664c

# サーバーのポート番号(省略可、デフォルト3000)
PORT=3000
